{
  "path-intellisense.mappings": {
    "/": "${workspaceFolder}/public"
  },

  // English everywhere (ADR 0009); Spanish only where the user's text lives.
  "cSpell.language": "en",
  "cSpell.overrides": [
    {
      // The message catalog, the Spanish docs, and the login files whose
      // examples are Spanish usernames (` MÚÑOZ1990 `).
      "filename": [
        "**/public/js/i18n/es.js",
        "**/*.es.md",
        "**/CREDITOS.md",
        "**/LICENCIA-CONTENIDO.md",
        "**/public/screens/login/validation.js",
        "**/tests/validation.test.js"
      ],
      "language": "en,es"
    }
  ],
  "cSpell.languageSettings": [
    {
      "languageId": "javascript",
      "includeRegExpList": ["CStyleComment", "string"],
      "ignoreRegExpList": ["/class=\"[^\"]*\"/g", "/[.#][a-z][\\w-]*/g"]
    }
  ],
  "cSpell.words": ["Balam", "beforeinstallprompt"],
  "emmet.includeLanguages": { "javascript": "html" },
  "editor.linkedEditing": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "cssVariables.lookupFiles": ["public/css/tokens.css"],
  "liveServer.settings.root": "/public"
}

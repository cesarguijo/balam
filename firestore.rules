rules_version = '2';

service cloud.firestore {


  match /databases/{database}/documents {

    match /teachers/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid);
    }

    function teacherGroupIds(){
      return get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.groupIds;
    }

    function familyGroupIds(){
      return get(/databases/$(database)/documents/families/$(request.auth.uid)).data.groupIds;
    }


    match /families/{uid} {
      allow read: if (request.auth != null && request.auth.uid==uid);
    }

    match /notices/{noticeId} {
      allow read: if(
      request.auth != null &&
      (
      resource.data.groupIds.hasAny(familyGroupIds()) ||
      resource.data.groupIds.hasAny(teacherGroupIds())
      )
      );

      allow create: if(
      request.auth != null &&
      request.resource.data.groupIds.size() > 0 &&
      request.resource.data.groupIds.hasOnly(teacherGroupIds())
      );

      allow update: if(
      request.auth != null &&
      request.resource.data.groupIds.size() > 0 &&
      request.resource.data.groupIds.hasOnly(teacherGroupIds()) &&
      resource.data.groupIds.hasOnly(teacherGroupIds())
      );

      allow delete: if(
      request.auth != null &&
      resource.data.groupIds.hasOnly(teacherGroupIds())
      );
    }
  }


}
